---
/**
 * 방문자 화면의 공통 틀: <head>(제목, 검색 엔진·SNS 미리보기 정보), 머리글, 바닥글, 검색 창
 */
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/nanum-pen-script';
import '../styles/base.css';
import '../styles/prose.css';
import '../styles/site.css';

import SearchDialog from '../components/SearchDialog.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SvgSprites from '../components/SvgSprites.astro';
import { absoluteUrl } from '../lib/runtime';
import { getSiteChrome } from '../lib/site';

interface Props {
  /** 화면 제목 (없으면 블로그 이름만) */
  title?: string;
  description?: string;
  /** 공유 미리보기 이미지 주소 (/media/... 또는 전체 주소) */
  image?: string | null;
  type?: 'website' | 'article';
  noindex?: boolean;
  canonicalPath?: string;
  article?: { publishedTime: Date; modifiedTime: Date; tags: string[] };
  jsonLd?: Record<string, unknown>;
  showRuler?: boolean;
}

const {
  title,
  description,
  image,
  type = 'website',
  noindex = false,
  canonicalPath,
  article,
  jsonLd,
  showRuler = false,
} = Astro.props;

const { settings, navPages, tags } = await getSiteChrome(Astro.locals);
const fullTitle = title ? `${title} · ${settings.siteTitle}` : `${settings.siteTitle} — ${settings.siteTagline}`;
const desc = (description || settings.siteDescription).slice(0, 200);
const canonical = absoluteUrl(Astro.url, canonicalPath ?? Astro.url.pathname);
const ogImage = absoluteUrl(Astro.url, image || '/og.png');
const ldJson = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline set:html={__THEME_INIT__} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f4f2ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111114" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={settings.siteTitle} href={absoluteUrl(Astro.url, '/rss.xml')} />

    <meta property="og:site_name" content={settings.siteTitle} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? settings.siteTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime.toISOString()} />
          <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
          {article.tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }
    {ldJson && <script is:inline type="application/ld+json" set:html={ldJson} />}
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <SvgSprites />
    <SiteHeader siteTitle={settings.siteTitle} navPages={navPages} showRuler={showRuler} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter settings={settings} />
    <SearchDialog tags={tags} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
