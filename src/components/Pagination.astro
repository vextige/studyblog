---
import Icon from './Icon.astro';
import { ChevronLeft, ChevronRight } from '../lib/icons';

interface Props {
  page: number;
  pages: number;
  /** 페이지 번호를 붙일 기본 주소 (지금 주소의 다른 검색 조건은 유지돼요) */
  url: URL;
}

const { page, pages, url } = Astro.props;

function hrefFor(n: number) {
  const next = new URL(url);
  if (n <= 1) next.searchParams.delete('page');
  else next.searchParams.set('page', String(n));
  return `${next.pathname}${next.search}`;
}

// 1 … 4 5 [6] 7 8 … 20 처럼 앞뒤 몇 개만 보여 줘요.
const numbers: (number | '…')[] = [];
for (let n = 1; n <= pages; n++) {
  if (n === 1 || n === pages || Math.abs(n - page) <= 2) numbers.push(n);
  else if (numbers.at(-1) !== '…') numbers.push('…');
}
---

{
  pages > 1 && (
    <nav class="pagination" aria-label="페이지 이동">
      {page > 1 ? (
        <a href={hrefFor(page - 1)} rel="prev" aria-label="이전 페이지">
          <Icon icon={ChevronLeft} />
        </a>
      ) : (
        <span class="disabled" aria-hidden="true">
          <Icon icon={ChevronLeft} />
        </span>
      )}
      {numbers.map((n) =>
        n === '…' ? (
          <span aria-hidden="true">…</span>
        ) : (
          <a href={hrefFor(n)} aria-current={n === page ? 'page' : undefined}>
            {n}
          </a>
        ),
      )}
      {page < pages ? (
        <a href={hrefFor(page + 1)} rel="next" aria-label="다음 페이지">
          <Icon icon={ChevronRight} />
        </a>
      ) : (
        <span class="disabled" aria-hidden="true">
          <Icon icon={ChevronRight} />
        </span>
      )}
    </nav>
  )
}
