---
// 100칸 도장판: 글을 쓴 Day 칸에 '참 잘했어요' 도장이 찍혀요.
import type { ChallengeState } from '../lib/challenge';
import { dayLabel } from '../lib/format';

interface Props {
  title: string;
  challenge: ChallengeState;
}

const { title, challenge } = Astro.props;
// 도장마다 조금씩 다른 각도로 찍혀요. (Day 번호로 정해져서 새로고침해도 같아요)
const tilt = (day: number) => `--r: ${((day * 47) % 31) - 15}deg`;
---

<section class="section wrap" id="board" aria-labelledby="board-title">
  <div class="board sheet">
    <header class="board-head">
      <div>
        <span class="label">Stamp board</span>
        <h2 id="board-title">{title}</h2>
      </div>
      <div class="board-progress">
        <span class="mono"><b>{challenge.stamped}</b> / {challenge.totalDays}칸 · {challenge.percent}%</span>
        <div
          class="progress"
          role="progressbar"
          aria-label="도장판 채운 정도"
          aria-valuemin="0"
          aria-valuemax={challenge.totalDays}
          aria-valuenow={challenge.stamped}
        >
          <i style={`--p: ${challenge.percent}%`}></i>
        </div>
      </div>
    </header>

    <ol class="board-grid">
      {
        challenge.cells.map((cell) => {
          const classes = ['cell', { 'is-stamped': cell.post, 'is-today': cell.isToday, 'is-future': cell.isFuture && !cell.post }];
          return (
            <li>
              {cell.post ? (
                <a
                  class:list={classes}
                  href={`/posts/${encodeURIComponent(cell.post.slug)}`}
                  title={`Day ${cell.day} · ${cell.post.title}`}
                  style={tilt(cell.day)}
                >
                  <span class="n">{dayLabel(cell.day)}</span>
                  <svg class="stamp-svg" viewBox="0 0 100 100" aria-hidden="true">
                    <use href="#stamp-mini" filter="url(#ink-rough)" />
                  </svg>
                  <span class="sr-only">{`Day ${cell.day}: ${cell.post.title}`}</span>
                </a>
              ) : (
                <span class:list={classes} aria-label={cell.isToday ? `Day ${cell.day}, 오늘` : `Day ${cell.day}`}>
                  <span class="n">{dayLabel(cell.day)}</span>
                  {cell.isToday && <span class="today-label">오늘</span>}
                </span>
              )}
            </li>
          );
        })
      }
    </ol>

    <footer class="board-foot">
      <div class="board-legend" aria-hidden="true">
        <span><i class="s"></i> 도장 쾅</span>
        <span><i class="t"></i> 오늘</span>
        <span><i></i> 빈칸</span>
      </div>
      <span>도장을 누르면 그날의 기록으로 가요.</span>
    </footer>
  </div>
</section>
