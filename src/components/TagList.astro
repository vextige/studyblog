---
// 태그 목록. 태그를 누르면 글 목록에서 그 태그 글만 보여줘요.
import { url } from '../lib/blog';

interface Props {
  tags: readonly string[];
}

const { tags } = Astro.props;
---

<ul class="tags" aria-label="태그">
  {
    tags.map((tag) => (
      <li>
        <a class="tag" data-tag={tag} href={url(`posts/?tag=${encodeURIComponent(tag)}`)}>
          #{tag}
        </a>
      </li>
    ))
  }
</ul>
