---
// 글 목록: 전체 글 + 태그 필터 + 검색
import PostItem from '../../components/PostItem.astro';
import { TAG_DESCRIPTIONS, TAGS, type Tag } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, url } from '../../lib/blog';

const posts = await getPosts();
const countByTag = (tag: Tag) => posts.filter((post) => post.data.tags.includes(tag)).length;
---

<BaseLayout title="글 목록" description="지금까지 쓴 모든 공부 기록">
  <h1 class="page-title">글 목록</h1>

  <div class="filters" data-search-url={url('search.json')}>
    <label>
      <span class="visually-hidden">글 검색</span>
      <input
        id="search-input"
        class="search-input"
        type="search"
        placeholder="제목, 내용, 태그로 검색"
        autocomplete="off"
      />
    </label>
    <div class="tag-filter" role="group" aria-label="태그로 골라 보기">
      <button type="button" data-filter-tag="" aria-pressed="true">
        전체 <span>{posts.length}</span>
      </button>
      {
        TAGS.map((tag) => (
          <button type="button" data-filter-tag={tag} aria-pressed="false" title={TAG_DESCRIPTIONS[tag]}>
            #{tag} <span>{countByTag(tag)}</span>
          </button>
        ))
      }
    </div>
  </div>

  <p id="result-count" class="result-count" aria-live="polite">글 {posts.length}개</p>
  <ul id="post-list" class="post-list">
    {posts.map((post) => <PostItem post={post} />)}
  </ul>
  <p id="empty-message" class="empty" hidden>조건에 맞는 글이 없어요.</p>
</BaseLayout>

<script>
  // 브라우저 안에서만 동작하는 태그 필터와 검색 (서버 없음)
  const filters = document.querySelector<HTMLElement>('[data-search-url]')!;
  const input = document.querySelector<HTMLInputElement>('#search-input')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter-tag]')];
  const items = [...document.querySelectorAll<HTMLElement>('#post-list > li')];
  const resultCount = document.querySelector('#result-count')!;
  const emptyMessage = document.querySelector<HTMLElement>('#empty-message')!;

  let activeTag = '';
  // 글 id → 검색용 글자(제목·요약·태그·본문). 처음 검색할 때 search.json에서 한 번만 불러와요.
  let searchIndex: Map<string, string> | null = null;
  let loading: Promise<void> | null = null;

  function loadSearchIndex() {
    loading ??= fetch(filters.dataset.searchUrl!)
      .then((res) => res.json() as Promise<{ id: string; text: string }[]>)
      .then((data) => {
        searchIndex = new Map(data.map((entry) => [entry.id, entry.text]));
      })
      .catch(() => {
        loading = null; // 실패하면 다음 입력 때 다시 시도하고, 그동안은 제목·요약으로만 찾아요
      });
    return loading;
  }

  function searchableText(item: HTMLElement) {
    return searchIndex?.get(item.dataset.id!) ?? item.textContent!.toLowerCase();
  }

  function applyFilters() {
    const query = input.value.trim().toLowerCase();
    const words = query.split(/\s+/).filter(Boolean);
    let shown = 0;

    for (const item of items) {
      const matchesTag = !activeTag || item.dataset.tags!.split(' ').includes(activeTag);
      const text = searchableText(item);
      const matchesSearch = words.every((word) => text.includes(word));
      item.hidden = !(matchesTag && matchesSearch);
      if (!item.hidden) shown++;
    }

    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.filterTag === activeTag));
    }
    resultCount.textContent = `글 ${shown}개`;
    emptyMessage.hidden = shown > 0;

    // 주소에 현재 조건을 남겨서 새로고침하거나 링크를 공유해도 그대로 보이게
    const params = new URLSearchParams();
    if (activeTag) params.set('tag', activeTag);
    if (query) params.set('q', input.value.trim());
    const search = params.toString();
    history.replaceState(null, '', search ? `?${search}` : location.pathname);
  }

  function setTag(tag: string) {
    activeTag = buttons.some((button) => button.dataset.filterTag === tag) ? tag : '';
    applyFilters();
  }

  for (const button of buttons) {
    button.addEventListener('click', () => setTag(button.dataset.filterTag!));
  }

  // 글 카드 안의 태그를 누르면 페이지를 다시 불러오지 않고 바로 거르기
  document.querySelector('#post-list')!.addEventListener('click', (event) => {
    const tagLink = (event.target as Element).closest<HTMLElement>('a.tag');
    if (!tagLink) return;
    event.preventDefault();
    setTag(tagLink.dataset.tag!);
    window.scrollTo({ top: 0 });
  });

  input.addEventListener('focus', () => loadSearchIndex(), { once: true });
  input.addEventListener('input', () => {
    applyFilters();
    if (!searchIndex) loadSearchIndex().then(applyFilters);
  });

  // 처음 열 때 주소에 ?tag= 나 ?q= 가 있으면 적용
  const params = new URLSearchParams(location.search);
  input.value = params.get('q') ?? '';
  setTag(params.get('tag') ?? '');
  if (input.value) loadSearchIndex().then(applyFilters);
</script>
