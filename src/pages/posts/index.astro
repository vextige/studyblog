---
// 모든 기록: 최신순 공부 장부 (달마다 나눠서)
import Icon from '../../components/Icon.astro';
import Pagination from '../../components/Pagination.astro';
import PostList from '../../components/PostList.astro';
import TagFilterBar from '../../components/TagFilterBar.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatStudyTime } from '../../lib/format';
import { PenLine } from '../../lib/icons';
import { getHomeData, listPublishedPosts } from '../../lib/posts';
import { listTags } from '../../lib/tags';

const page = Math.max(1, Math.floor(Number(Astro.url.searchParams.get('page')) || 1));
const [list, tags, home] = await Promise.all([listPublishedPosts({ page, perPage: 15 }), listTags(), getHomeData()]);
if (page > list.pages) return Astro.redirect(list.pages > 1 ? `/posts?page=${list.pages}` : '/posts', 302);
const isAdmin = Boolean(Astro.locals.user);
---

<BaseLayout
  title={page > 1 ? `모든 기록 (${page}쪽)` : '모든 기록'}
  description="지금까지 공부하고 남긴 모든 기록"
  canonicalPath={page > 1 ? `/posts?page=${page}` : '/posts'}
>
  <div class="wrap">
    <header class="page-head">
      <span class="label">Archive · 공부 장부</span>
      <h1>모든 기록</h1>
      <p class="lead">
        지금까지 <mark>{list.total}개</mark>의 기록을 남겼어요.
        {home.studyMinutes > 0 && <>모두 합치면 <mark data-color="sky">{formatStudyTime(home.studyMinutes)}</mark> 공부했어요.</>}
      </p>
    </header>

    <TagFilterBar tags={tags} total={list.total} />

    {
      list.posts.length > 0 ? (
        <>
          <PostList posts={list.posts} byMonth />
          <Pagination page={list.page} pages={list.pages} url={Astro.url} />
        </>
      ) : (
        <div class="empty">
          <p class="hand">아직 빈 장부예요</p>
          <p>첫 기록이 올라오면 여기에 차곡차곡 쌓여요.</p>
          {isAdmin && (
            <a class="btn btn-primary" href="/admin/posts/new" data-astro-prefetch="false">
              <Icon icon={PenLine} /> 첫 글 쓰기
            </a>
          )}
        </div>
      )
    }
  </div>
</BaseLayout>
