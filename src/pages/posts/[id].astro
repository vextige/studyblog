---
// 글 상세: 글 하나(.md 파일 하나)마다 이 틀로 페이지가 하나씩 만들어져요.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import TagList from '../../components/TagList.astro';
import { TOTAL_DAYS } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts, url, type Post } from '../../lib/blog';

export const getStaticPaths = (async () => {
  const posts = await getPosts(); // 최근 글이 앞쪽
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, date, day, tags, description } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="post-header">
      <span class="day-badge">Day {day} / {TOTAL_DAYS}</span>
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <TagList tags={tags} />
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>

  {
    (older || newer) && (
      <nav class="post-nav" aria-label="이전 글, 다음 글">
        {older && (
          <a class="prev" href={url(`posts/${older.id}/`)}>
            <small>← 이전 글</small>
            Day {older.data.day} · {older.data.title}
          </a>
        )}
        {newer && (
          <a class="next" href={url(`posts/${newer.id}/`)}>
            <small>다음 글 →</small>
            Day {newer.data.day} · {newer.data.title}
          </a>
        )}
      </nav>
    )
  }

  <a class="back-link" href={url('posts/')}>← 글 목록으로</a>
</BaseLayout>
