---
// 없는 주소로 들어왔을 때
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowLeft, Search } from '../lib/icons';

Astro.response.status = 404;
---

<BaseLayout title="페이지를 찾을 수 없어요" noindex>
  <section class="lost wrap">
    <p class="lost-num" aria-hidden="true">404</p>
    <h1>여긴 아직 빈 칸이에요</h1>
    <p>주소가 바뀌었거나, 지워진 기록일 수 있어요.</p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="/"><Icon icon={ArrowLeft} /> 홈으로</a>
      <button class="btn btn-ghost" type="button" data-search-open><Icon icon={Search} /> 기록 찾기</button>
    </div>
  </section>
</BaseLayout>
