---
// 홈: 진행 바 + 최근 글
import PostItem from '../components/PostItem.astro';
import { SITE_DESCRIPTION, SITE_TITLE, TOTAL_DAYS } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, url } from '../lib/blog';

const posts = await getPosts();
// 지금까지 쓴 글 중 가장 큰 Day 번호 = 현재 진행한 날
const currentDay = posts.length ? Math.max(...posts.map((post) => post.data.day)) : 0;
const percent = Math.min(100, Math.round((currentDay / TOTAL_DAYS) * 100));
const recentPosts = posts.slice(0, 5);
---

<BaseLayout>
  <section class="hero">
    <h1>{SITE_TITLE}</h1>
    <p>{SITE_DESCRIPTION}</p>
  </section>

  <section class="progress-card" aria-labelledby="progress-heading">
    <div class="progress-head">
      <h2 id="progress-heading">진행 상황</h2>
      <p class="progress-count"><strong>Day {currentDay}</strong> / {TOTAL_DAYS}</p>
    </div>
    <div
      class="progress-track"
      role="progressbar"
      aria-label={`${TOTAL_DAYS}일 중 진행한 날`}
      aria-valuemin="0"
      aria-valuemax={TOTAL_DAYS}
      aria-valuenow={currentDay}
    >
      <div class="progress-fill" style={`width: ${percent}%`}></div>
    </div>
    <p class="progress-note">
      {percent}% 완료 · 남은 날 {TOTAL_DAYS - currentDay}일 · 쓴 글 {posts.length}개
    </p>
  </section>

  <section aria-labelledby="recent-heading">
    <div class="section-head">
      <h2 id="recent-heading">최근 글</h2>
      <a href={url('posts/')}>전체 글 보기 →</a>
    </div>
    {
      recentPosts.length ? (
        <ul class="post-list">
          {recentPosts.map((post) => (
            <PostItem post={post} />
          ))}
        </ul>
      ) : (
        <p class="empty">아직 글이 없어요. 첫 글을 써 볼까요?</p>
      )
    }
  </section>
</BaseLayout>
