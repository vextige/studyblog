---
// 기록 고치기
import PostEditor, { type EditorPostData } from '../../../components/admin/PostEditor';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { mediaUrl } from '../../../lib/media';
import { getPostForEdit } from '../../../lib/posts';
import { listTags } from '../../../lib/tags';
import { toKstInputValue } from '../../../lib/time';
import { getDb, schema } from '../../../db/client';
import { inArray } from 'drizzle-orm';

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return new Response(null, { status: 404 });
const [post, tags] = await Promise.all([getPostForEdit(id), listTags({ publicOnly: false })]);
if (!post) return new Response(null, { status: 404 });
if (post.status === 'trashed') return Astro.redirect('/admin/posts?filter=trashed', 303);

// 대표 이미지 · 공유 이미지 주소 (확장자를 붙이려면 이미지 형식이 필요해요)
const mediaIds = [post.coverMediaId, post.ogMediaId].filter((v): v is string => Boolean(v));
const mimes = mediaIds.length
  ? await getDb().select({ id: schema.media.id, mime: schema.media.mime }).from(schema.media).where(inArray(schema.media.id, mediaIds)).all()
  : [];
const urlOf = (mid: string | null) => {
  const found = mid ? mimes.find((m) => m.id === mid) : undefined;
  return found ? mediaUrl(found.id, found.mime) : null;
};

const initial: EditorPostData = {
  id: post.id,
  title: post.title,
  slug: post.slug,
  contentMd: post.contentMd,
  excerpt: post.excerpt,
  tagNames: post.tags.map((t) => t.name),
  dayNumber: post.dayNumber,
  studyMinutes: post.studyMinutes,
  status: post.status,
  publishedAt: post.publishedAt ? toKstInputValue(post.publishedAt) : null,
  coverMediaId: post.coverMediaId,
  coverUrl: urlOf(post.coverMediaId),
  ogMediaId: post.ogMediaId,
  ogUrl: urlOf(post.ogMediaId),
  featured: post.featured,
  allowComments: post.allowComments,
  updatedAt: post.updatedAt.getTime(),
};
---

<AdminLayout title="기록 고치기" kicker={post.dayNumber ? `Edit · DAY ${String(post.dayNumber).padStart(3, '0')}` : 'Edit'}>
  <PostEditor client:only="preact" initial={initial} tags={tags.map((t) => ({ name: t.name, color: t.color }))} />
</AdminLayout>
