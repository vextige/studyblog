{
  "name": "studyblog",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "types": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "node scripts/build-seed.mjs && wrangler d1 execute DB --local --file seed/seed.sql",
    "db:seed:remote": "node scripts/build-seed.mjs && wrangler d1 execute DB --remote --file seed/seed.sql",
    "db:backup": "wrangler d1 export DB --remote --output backups/backup-$(date +%Y%m%d-%H%M%S).sql",
    "setup:local": "node scripts/setup-local.mjs",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/preact": "^6.1.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/nanum-pen-script": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "astro": "^7.4.2",
    "drizzle-orm": "^0.45.4",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.12.0",
    "lucide": "^1.61.0",
    "markdown-it": "^15.0.3",
    "markdown-it-container": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "preact": "^11.0.2",
    "pretendard": "^1.3.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
